{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SonicBoard",
  "version": "2.1.0",
  "identifier": "com.sonicboard.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SonicBoard: Low-Latency Audio Routing & Soundboard Console",
        "width": 1360,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
